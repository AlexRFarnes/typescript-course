{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["DOM", "ES2022", "DOM.iterable", "ScriptHost"],
    "outDir": "./dist",
    "rootDir": "./src",
    "removeComments": true,
    "noEmitOnError": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,

    "noImplicitReturns": true,
    "esModuleInterop": true,

    "experimentalDecorators": true
  },
  "exclude": ["node_modules", "dist"]
}
